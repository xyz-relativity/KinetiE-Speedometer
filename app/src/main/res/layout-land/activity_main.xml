<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:gauge="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_background"
    tools:context=".MainActivity">

    <LinearLayout
        android:id="@+id/statusRow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_alignParentStart="true"
        android:layout_marginStart="8dp"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/chipGps"
            style="@style/StatusChip"
            android:drawableStart="@drawable/status_dot"
            android:drawablePadding="6dp"
            android:text="@string/chip_no_fix" />

        <TextView
            android:id="@+id/chipDeadReckoning"
            style="@style/StatusChip"
            android:textColor="@color/status_fair"
            android:visibility="gone"
            android:text="@string/chip_dead_reckoning"
            tools:text="DR 12s"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/chipCalibrating"
            style="@style/StatusChip"
            android:visibility="gone"
            android:text="@string/chip_calibrating"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/chipRecording"
            style="@style/StatusChip"
            android:textColor="@color/chip_recording"
            android:visibility="gone"
            android:text="@string/chip_recording"
            tools:visibility="visible" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/buttonSettings"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:layout_marginEnd="4dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/settings_title"
        android:scaleType="centerInside"
        android:src="@drawable/ic_settings"
        app:tint="@color/text_muted" />

    <!-- Car mount: the chart is what matters here, so it takes most of the width; the dial and
         readouts share a compact column on the left. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:paddingTop="34dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.42"
            android:orientation="vertical"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingBottom="4dp">

            <de.nitri.gauge.Gauge
                android:id="@+id/gauge"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_gravity="center_horizontal"
                gauge:flat="true"
                gauge:arc="true"
                gauge:arcColor="@color/accent_energy"
                gauge:faceColor="@color/gauge_face"
                gauge:rimColor="@color/gauge_rim"
                gauge:scaleColor="@color/gauge_tick"
                gauge:needleColor="@color/accent_speed"
                gauge:needleShadow="false"
                gauge:nickLabelTextSize="18sp"
                gauge:upperText="0"
                gauge:upperTextColor="@color/text_primary"
                gauge:upperTextUnit="@string/unit_kph"
                gauge:lowerText=""
                gauge:lowerTextUnit="" />

            <LinearLayout
                android:id="@+id/readouts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">

                <LinearLayout
                    style="@style/ReadoutTile"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp">

                    <TextView
                        style="@style/ReadoutLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/readout_fall" />

                    <TextView
                        android:id="@+id/readoutEnergy"
                        style="@style/ReadoutValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/accent_energy"
                        android:text="0" />
                </LinearLayout>

                <LinearLayout
                    style="@style/ReadoutTile"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp">

                    <TextView
                        style="@style/ReadoutLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/readout_acceleration" />

                    <TextView
                        android:id="@+id/readoutAcceleration"
                        style="@style/ReadoutValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0.00" />
                </LinearLayout>

                <LinearLayout
                    style="@style/ReadoutTile"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">

                    <TextView
                        style="@style/ReadoutLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/readout_max_speed" />

                    <TextView
                        android:id="@+id/readoutMaxSpeed"
                        style="@style/ReadoutValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tripRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:background="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tripSummary"
                    style="@style/Odometer"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:text="0.0 km trip, 0 min"
                    tools:text="12.4 km trip, 42 min, avg 31 km/h" />

                <TextView
                    android:id="@+id/odometer"
                    style="@style/Odometer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="0.0 km total"
                    tools:text="167.5 km total" />
            </LinearLayout>
        </LinearLayout>

        <com.github.mikephil.charting.charts.LineChart
            android:id="@+id/historyChart"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.58"
            android:background="@android:color/transparent" />

    </LinearLayout>

</RelativeLayout>
